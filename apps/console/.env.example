AWF_API_BASE_URL=http://localhost:8000
AWF_API_TOKEN=
NEXT_PUBLIC_AWF_CONSOLE_POLL_MS=5000

# Browser-visible same-origin path bases (build-time for Next). Local defaults
# keep the console at "/" with /api/awf and /api/operator. Hosted example:
#   NEXT_PUBLIC_AWF_CONSOLE_BASE_PATH=/workspaces
#   NEXT_PUBLIC_AWF_CONSOLE_API_BASE=/api/core-console
#   NEXT_PUBLIC_AWF_CONSOLE_OPERATOR_BASE=/api/core-console
#   NEXT_PUBLIC_AWF_CONSOLE_CONTEXT_QUERY_KEYS=org_id,project_id
# Context keys are key *names* only (values come from the page URL at request time).
NEXT_PUBLIC_AWF_CONSOLE_BASE_PATH=
NEXT_PUBLIC_AWF_CONSOLE_API_BASE=/api/awf
NEXT_PUBLIC_AWF_CONSOLE_OPERATOR_BASE=/api/operator
NEXT_PUBLIC_AWF_CONSOLE_CONTEXT_QUERY_KEYS=

# Optional comma-separated origins allowed to access the Next dev server.
# Useful for private dev hostnames such as Tailscale MagicDNS names.
AWF_CONSOLE_ALLOWED_DEV_ORIGINS=
