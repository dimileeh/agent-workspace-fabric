# AWF Control Plane configuration — copy to .env and fill in.

# Service identity
AWF_SERVICE_NAME=awf
AWF_ENV=local
AWF_LOG_LEVEL=INFO

# API
AWF_API_HOST=0.0.0.0
AWF_API_PORT=8000
# Host/operator CLI target. Usually leave unset; the CLI derives
# http://localhost:${AWF_API_HOST_PORT:-8000}. Set this for reverse proxies or
# when running the CLI from a shell that does not carry AWF_API_HOST_PORT.
# AWF_BASE_URL=http://localhost:8000
# Deprecated host CLI override; still honored for compatibility. Prefer AWF_BASE_URL.
# AWF_CLI_BASE_URL=http://localhost:8000
# API self-reference URL for service-side doctor/smoke/status. Local Compose
# containers override this to http://api:8000; do not use it as the host CLI target.
AWF_API_BASE_URL=http://localhost:8000
# Set a local bearer token before starting protected API controls.
AWF_API_TOKEN=
# Optional local console URL used by smoke reports. Leave commented unless you
# run the console on a non-default host; AWF probes http://localhost:3000 by default.
# AWF_CONSOLE_URL=http://localhost:3000

# Database (control-plane Postgres)
AWF_POSTGRES_PASSWORD=awf_dev
AWF_DATABASE_URL=postgresql+asyncpg://awf:awf_dev@localhost:5433/awf

# Test database server. The Postgres integration suite creates and drops a
# temporary database on this server; it does not downgrade the live AWF DB.
AWF_TEST_DATABASE_URL=postgresql+asyncpg://awf:awf_dev@localhost:5433/awf

# Local Postgres shared memory. Keep this above Docker's 64 MB default when
# running the real PostgreSQL test suite with local pytest parallelism.
AWF_POSTGRES_SHM_SIZE=1g

# GitHub (for PR creation). Local service containers cannot read macOS Keychain
# backed gh auth. Prefer AWF_GITHUB_TOKEN; GH_TOKEN/GITHUB_TOKEN are accepted
# fallbacks by docker/compose/local-service.yml and service settings.
# Example: export AWF_GITHUB_TOKEN="$(gh auth token)"
AWF_GITHUB_TOKEN=
AWF_GITHUB_DEFAULT_BASE_BRANCH=development

# Bitbucket Cloud (Atlassian API token). Required only for bitbucket.org repos.
# Used by the REST ForgeClient and by git over HTTPS (clone + push). Basic auth
# pairs BITBUCKET_EMAIL with the Atlassian API token; app passwords are not
# supported. Leave empty for GitHub-only setups.
BITBUCKET_API_TOKEN=
BITBUCKET_EMAIL=
BITBUCKET_AUTH_MODE=basic

# Claude Code readiness accepts env auth or mounted ~/.claude / ~/.claude.json.
# Set only the auth mode you use; values are redacted from service status output.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_SMALL_FAST_MODEL=
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CODE_USE_BEDROCK=
CLAUDE_CODE_USE_VERTEX=

# Cursor readiness accepts env-only auth.
CURSOR_API_KEY=

# Gemini readiness accepts Gemini/Google env auth, GOOGLE_APPLICATION_CREDENTIALS
# when the referenced file is visible in the service container, or mounted ~/.gemini.
GEMINI_API_KEY=
GEMINI_API_KEY_AUTH_MECHANISM=
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_GENAI_USE_GCA=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_CLOUD_ACCESS_TOKEN=

# OpenCode/Ollama readiness accepts mounted ~/.config/opencode, small ~/.ollama
# auth files, OLLAMA_API_KEY, and a cheap Ollama /api/version probe.
AWF_OPENCODE_OLLAMA_BASE_URL=
OLLAMA_HOST=
OLLAMA_API_KEY=
# Default timeout for individual OpenCode bash tool calls inside workspaces.
# Targeted tests can exceed OpenCode's upstream 120s default on slower models.
OPENCODE_EXPERIMENTAL_BASH_DEFAULT_TIMEOUT_MS=600000

# Optional Linux-only Ollama bridge. Use this when host Ollama listens only on
# 127.0.0.1 and Linux containers cannot reach it through host.docker.internal.
# Enable by setting COMPOSE_PROFILES=ollama-bridge in the environment used by
# Docker Compose, then keep OpenCode pointed at host.docker.internal:11434.
COMPOSE_PROFILES=
AWF_OLLAMA_BRIDGE_BIND_ADDRESS=172.17.0.1
AWF_OLLAMA_BRIDGE_LISTEN_PORT=11434
AWF_OLLAMA_BRIDGE_TARGET_HOST=127.0.0.1
AWF_OLLAMA_BRIDGE_TARGET_PORT=11434

# Docker (path to socket or tcp endpoint)
AWF_DOCKER_HOST=unix:///var/run/docker.sock

# Agent runtime image (built from docker/agent-runtime.Dockerfile)
AWF_AGENT_RUNTIME_IMAGE=awf-agent-runtime:latest

# Companion image cache. When enabled, each companion image is pre-built once per
# (name, build inputs) on the host daemon and reused across parallel dispatches.
# Set to false to disable the cache; retention is the creation age (hours) after
# which cached companion images are pruned by service GC.
AWF_COMPANION_IMAGE_CACHE_ENABLED=true
AWF_COMPANION_IMAGE_RETENTION_HOURS=168

# Local AWF state root for direct CLI/API runs.
AWF_WORK_DIR=.awf

# Optional host-visible state root for docker-outside-of-docker local service mode.
# Leave unset to let docker/compose/local-service.yml use ${HOME}/.awf/service.
AWF_HOST_WORK_DIR=

# Host home directory mounted read-only into local service containers so the
# worker can discover gh/git/ssh/provider auth and copy isolated Codex auth for
# workspace stacks. Leave unset to use ${HOME}.
AWF_HOST_HOME=

# Optional host SSH-agent socket for local service mode. On Linux, Docker
# Compose falls back to SSH_AUTH_SOCK when this is unset; Docker Desktop keeps
# using /run/host-services/ssh-auth.sock.
AWF_HOST_SSH_AUTH_SOCK=

# Worker
AWF_WORKER_POLL_INTERVAL_SECONDS=1
AWF_WORKER_MAX_CONCURRENT_PROVISIONS=3
AWF_WORKER_MAX_CONCURRENT_EXECUTIONS=3
AWF_WORKER_NODE_ID=
AWF_WORKER_BRANCH_PREFIX=awf
# Agent execution watchdogs. AWF terminates the agent CLI if either limit is hit.
AWF_AGENT_WALL_TIMEOUT_SECONDS=7200
AWF_AGENT_IDLE_TIMEOUT_SECONDS=3600
# Planning. Used only when a workspace profile omits planning.max_iterations;
# explicit profile values win.
AWF_PLANNING_MAX_ITERATIONS_DEFAULT=3

# Retention cleanup. Failed workspaces are preserved for triage by default.
AWF_COMPLETED_WORKSPACE_RETENTION_HOURS=168
AWF_WORKSPACE_CLEANUP_ENABLED=true
AWF_WORKSPACE_CLEANUP_SCAN_INTERVAL_SECONDS=3600
AWF_WORKSPACE_CLEANUP_BATCH_LIMIT=50

# Orphan filesystem reconcile. Default OFF: the worker sweep and readiness reaper
# run report-only until an operator opts into ACTUAL deletion via the kill-switch.
AWF_AUTO_CLEANUP_ORPHANS=false
# Shared ~/.claude overlay base reaper (GC-B). On by default; only acts under
# --execute and never removes the current-signature, live-mounted, or pinned base.
AWF_CLAUDE_BASE_GC_ENABLED=true
AWF_ORPHAN_RECONCILE_SCAN_INTERVAL_SECONDS=3600
AWF_ORPHAN_RECONCILE_MAX_PER_SCAN=50
AWF_ORPHAN_RECONCILE_MIN_AGE_HOURS=168

# Workspace resource defaults (overridable per-request)
AWF_WORKSPACE_STEADY_CPU=3
AWF_WORKSPACE_STEADY_MEMORY_GB=10
AWF_WORKSPACE_PEAK_CPU=6
AWF_WORKSPACE_PEAK_MEMORY_GB=16
