FROM node:22-bookworm-slim

WORKDIR /app

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /app/browser /app/scripts /ms-playwright \
    && PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm install --prefix /app/browser \
        --omit=dev \
        --no-audit \
        --no-fund \
        --no-save \
        playwright@1.49.1 \
    && npm --prefix /app/browser exec -- playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 awf \
    && mkdir -p /home/awf/.cache /home/awf/.config \
    && chown -R awf:awf /app /home/awf /ms-playwright

COPY --chown=awf:awf browser/validator-server.mjs ./browser/validator-server.mjs
COPY --chown=awf:awf scripts/container-healthcheck.mjs ./scripts/container-healthcheck.mjs

ENV NODE_ENV=production
ENV HOME=/home/awf
ENV XDG_CACHE_HOME=/home/awf/.cache
ENV XDG_CONFIG_HOME=/home/awf/.config
ENV PORT=9323
ENV APP_BASE_URL=http://app:3000

EXPOSE 9323

USER awf

CMD ["node", "/app/browser/validator-server.mjs"]
